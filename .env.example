# CareBridge AI - Environment Variables & LLM API Configuration
# Get free API keys from:
# 1. Google Gemini API (Primary & Free): https://aistudio.google.com/
# 2. Groq Cloud API (Backup & Free - 30 req/min): https://console.groq.com/
# 3. OpenAI API: https://platform.openai.com/
# 4. DeepSeek API: https://platform.deepseek.com/

# AI Provider Selection: gemini | groq | openai | deepseek
AI_PROVIDER=gemini

# Google Gemini API Key (Primary)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (FREE BACKUP - get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Soniox Real-Time Voice STT API Key (https://soniox.com/)
SONIOX_API_KEY=your_soniox_api_key_here
SONIOX_VOICE_PORT=5000
SONIOX_WS_URL=ws://localhost:5000/ws/voice
